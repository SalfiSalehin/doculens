# Copy with:  py -3.11 scripts\make_env.py   (fills the secret for you)
# Never commit the real .env.

DOCULENS_ENV=development
DOCULENS_SECRET_KEY=change-me
DOCULENS_LOG_LEVEL=INFO

# Comma-separated, exact origins only. "*" is rejected.
DOCULENS_CORS_ORIGINS=http://localhost:5173

# Limits
DOCULENS_MAX_UPLOAD_MB=10
DOCULENS_MAX_IMAGE_PIXELS=40000000
DOCULENS_MAX_PDF_PAGES=3
DOCULENS_RATE_LIMIT_PER_MINUTE=30

# Storage
DOCULENS_UPLOAD_DIR=var/uploads
DOCULENS_UPLOAD_TTL_MINUTES=30

# Only set true when running behind a reverse proxy you control.
DOCULENS_TRUST_PROXY=false
